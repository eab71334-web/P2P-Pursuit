; Engine configuration file.
config_version=5

[application]

config/name="Hairpin Rush"
run/main_scene="res://scenes/intro.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://art/icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)

[autoload]

L="*res://scripts/i18n.gd"
Gfx="*res://scripts/gfx.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"
Profile="*res://scripts/profile.gd"
Radio="*res://scripts/radio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
