extends Node
## Sound effects. All sounds are generated by tools/make_sounds.py (no external files needed).

var _cache := {}
var master_db := 0.0


func stream(sname: String, looped := false) -> AudioStreamWAV:
	var key := sname + ("_L" if looped else "")
	if _cache.has(key):
		return _cache[key]
	var base := load("res://audio/%s.wav" % sname) as AudioStreamWAV
	if base == null:
		return null
	var s := base.duplicate() as AudioStreamWAV
	if looped:
		s.loop_mode = AudioStreamWAV.LOOP_FORWARD
		s.loop_begin = 0
		s.loop_end = s.data.size() / (2 if s.format == AudioStreamWAV.FORMAT_16_BITS else 1)
	_cache[key] = s
	return s


## fire-and-forget (non positional)
func play(sname: String, vol_db := 0.0, pitch := 1.0) -> void:
	var s := stream(sname)
	if s == null:
		return
	var p := AudioStreamPlayer.new()
	p.stream = s
	p.volume_db = vol_db + master_db
	p.pitch_scale = pitch
	add_child(p)
	p.finished.connect(p.queue_free)
	p.play()


## positional one-shot attached to a node
func play3d(sname: String, parent: Node3D, vol_db := 0.0, pitch := 1.0) -> void:
	var s := stream(sname)
	if s == null or not is_instance_valid(parent):
		return
	var p := AudioStreamPlayer3D.new()
	p.stream = s
	p.volume_db = vol_db + master_db
	p.pitch_scale = pitch
	p.unit_size = 14.0
	p.max_distance = 200.0
	parent.add_child(p)
	p.finished.connect(p.queue_free)
	p.play()


## a looping player you control yourself
func loop3d(sname: String, parent: Node3D, vol_db := -80.0) -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	p.stream = stream(sname, true)
	p.volume_db = vol_db
	p.unit_size = 14.0
	p.max_distance = 200.0
	parent.add_child(p)
	p.play()
	return p
